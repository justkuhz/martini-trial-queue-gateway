{
  "name": "martini-trial-queue-gateway",
  "version": "1.0.0",
  "description": "Ken Zhu Work Trial: Minimal fal-like async queue gateway trial project",
  "main": "dist/api/server.js",
  "scripts": {
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/worker/worker.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "check": "tsc -p tsconfig.json --noEmit"
  },
